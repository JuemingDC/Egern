#!name = RuCu6 Loon UA Test
#!desc = 测试 RuCu6 插件服务器实际需要匹配到哪一级 Loon User-Agent
#!author = chance
#!date = 2026-09-18
#!tag = 调试,兼容性,User-Agent
#!type = normal

# ============================================================
# 模块分类：网络兼容 / User-Agent 测试
# 作者：chance
# 创建时间：2026-09-18
#
# 测试目标：
# https://rucu6.pages.dev/Plugins/myblockads.lpx
#
# 测试顺序：
# 1. Loon
# 2. Loon/991
# 3. 完整 UA
#
# 用于判断 RuCu6 服务端究竟检测：
# - 仅 "Loon" 字样
# - Loon Build
# - 完整 CFNetwork / Darwin UA
# ============================================================

[Argument]
ua = select,"Loon","Loon/991","Loon/991 CFNetwork/3896.100.1.1.1 Darwin/27.0.0",tag=测试 UA,desc=依次选择三个 UA 测试 RuCu6 插件能否被 Egern 正常拉取

[Rewrite]
request if ${url} ~= /^https:\/\/rucu6\.pages\.dev\/Plugins\/myblockads\.lpx(?:\?.*)?$/ then request.header.set("User-Agent", "${ua}")

[Mitm]
hostname = rucu6.pages.dev