#!name = RuCu6 Loon UA
#!desc = 为 RuCu6 Pages 全部资源模拟 Loon User-Agent，解决 Egern 拉取插件及其依赖脚本失败的问题
#!author = chance
#!date = 2026-09-18
#!category = 网络兼容 / User-Agent
#!type = normal

# ============================================================
# RuCu6 Loon UA Compatibility
#
# Author: chance
# Date: 2026-09-18
# Category: 网络兼容 / User-Agent
#
# 
# 已验证：
# User-Agent = Loon
# 可以使 Egern 正常拉取：
# - /Plugins/*.lpx
# - /Scripts/*.js
#
# 因此不再限制具体目录，统一处理 rucu6.pages.dev 全部资源，
# 同时兼容未来新增的 Plugins / Scripts / Rules / Icons 等路径。
# ============================================================

[Rewrite]
request if ${url} ~= /^https:\/\/rucu6\.pages\.dev\// then request.header.set("User-Agent", "Loon")

[Mitm]
hostname = rucu6.pages.dev